      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hermes_voice_wake_misses_total[30m])) / clamp_min(sum(rate(hermes_voice_wake_activations_total[30m])), 1e-9)",
          "legendFormat": "доля промахов",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "sum(rate(hermes_voice_wake_no_name_total[30m])) / clamp_min(sum(rate(hermes_voice_wake_activations_total[30m])), 1e-9)",
          "legendFormat": "доля без имени",
          "refId": "B",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "stacking": {
              "mode": "none"
            },
            "fillOpacity": 12,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
