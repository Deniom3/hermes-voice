        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "expr": "hermes_voice_dataset_files{kind=\"negatives\"}",
          "legendFormat": "negatives",
          "refId": "B"
