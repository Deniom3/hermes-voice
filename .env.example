# Настройки контура. Панель читает файл через EnvironmentFile юнита,
# хаб получает те же переменные из окружения процесса.
# Реальный .env в git не попадает — здесь только шаблон без значений-секретов.

# ── Панель ──────────────────────────────────────────────────────────────
VOICE_PORT=8792

# Хаб, к которому подключается панель: он держит весь голосовой тракт
# (ключевое слово, распознавание, агент, синтез). Настройки распознавания
# и синтеза живут в voice-hub, не здесь.
VOICE_HUB_URL=ws://127.0.0.1:8796/ws

# Окно живого браузера и трансляция стола
VOICE_CDP_URL=http://127.0.0.1:9223
VOICE_VNC_HTTP=http://127.0.0.1:6080
VOICE_VNC_WS=ws://127.0.0.1:6080/websockify

# ── Хаб ─────────────────────────────────────────────────────────────────
# Речевой шлюз: распознавание и синтез за одним адресом.
# Если шлюз на другой машине — укажите её адрес, иначе останется локальный.
ASR_URL=http://127.0.0.1:8000/v1/audio/transcriptions
TTS_URL=http://127.0.0.1:8000/v1/audio/speech

# Агент Hermes и файл с его токеном
HERMES_WS_URL=ws://127.0.0.1:9119
HERMES_DASH_TOKEN_FILE=~/.hermes/.dash_token

# Home Assistant: без обеих переменных быстрый дом выключен
HASS_URL=
HASS_TOKEN=

# Колонка, чья комната считается «комнатой по умолчанию»
STATION_ENTITY=media_player.yandex_station_lite

# Пороги конца реплики
VOICE_SILENCE_MS=900
VOICE_HARD_SILENCE_MS=3500
SMART_TURN_THRESHOLD=0.75
