# Переменные окружения хаба и панели.
#
# Основной конфиг — hub.json (пример: hub/config.example.json): адреса шлюза,
# агента, MQTT, Music Assistant, пороги диалога и привязки станций живут там.
# Здесь только то, что не должно лежать в JSON: секреты, пути к файлам и
# настройки панели. Любой ключ hub.json можно переопределить переменной
# HUB_<ПУТЬ>: mqtt.prefix → HUB_MQTT_PREFIX, dialog.silence_ms →
# HUB_DIALOG_SILENCE_MS. Пустое значение считается «не задано».
#
# Реальный .env в git не попадает — здесь только шаблон без секретов.

# ── Панель ──────────────────────────────────────────────────────────────
VOICE_PORT=8792
VOICE_HUB_URL=ws://127.0.0.1:8796/ws

# Окно живого браузера и трансляция стола
VOICE_CDP_URL=http://127.0.0.1:9223
VOICE_VNC_HTTP=http://127.0.0.1:6080
VOICE_VNC_WS=ws://127.0.0.1:6080/websockify

# ── Секреты хаба ────────────────────────────────────────────────────────
# Home Assistant: без обеих переменных быстрый дом выключен
HASS_URL=
HASS_TOKEN=

# Пароль брокера. Хост, порт, пользователь и префикс — в hub.json → mqtt.*
MQTT_PASSWORD=

# Токен агента Hermes
HERMES_DASH_TOKEN_FILE=/root/.hermes/.dash_token

# ── Необязательные переопределения ──────────────────────────────────────
# По умолчанию берутся из hub.json; раскомментировать для отладки.
# ASR_URL=http://127.0.0.1:8000/v1/audio/transcriptions
# TTS_URL=http://127.0.0.1:8000/v1/audio/speech
# HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
# MQTT_HOST=
# MQTT_PREFIX=hermes/stations
# KWS_MODEL_JSON=/srv/kws/models/wakeword_e90e6e54.json
# VOICE_FILLERS=1
# MA_MCP_BIN=/root/.local/bin/music-assistant-mcp

# Сбор данных ключевого слова, кольцо и пороги — в hub.json:
# wake.train.*, wake.ring.*, wake.miss_min, dialog.*
