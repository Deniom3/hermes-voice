# Настройки контура. Панель читает файл через EnvironmentFile юнита,
# хаб получает те же переменные из окружения процесса.
# Реальный .env в git не попадает — здесь только шаблон без значений-секретов.

# ── Панель ──────────────────────────────────────────────────────────────
VOICE_PORT=8792

# Хаб, к которому подключается панель: он держит весь голосовой тракт
# (ключевое слово, распознавание, агент, синтез). Настройки распознавания
# и синтеза живут в voice-hub, не здесь.
VOICE_HUB_URL=ws://127.0.0.1:8796/ws

# Окно живого браузера и трансляция стола
VOICE_CDP_URL=http://127.0.0.1:9223
VOICE_VNC_HTTP=http://127.0.0.1:6080
VOICE_VNC_WS=ws://127.0.0.1:6080/websockify

# ── Хаб ─────────────────────────────────────────────────────────────────
# Речевой шлюз: распознавание и синтез за одним адресом.
# Если шлюз на другой машине — укажите её адрес, иначе останется локальный.
ASR_URL=http://127.0.0.1:8000/v1/audio/transcriptions
TTS_URL=http://127.0.0.1:8000/v1/audio/speech

# Агент Hermes и файл с его токеном
# Заполнители тишины: 1 — включить (по умолчанию выключены до прослушивания)
# VOICE_FILLERS=1

# Адрес Hermes — в hub.json → hermes.url.
# Эта переменная только явно переопределяет его для отладки.
# HERMES_WS_URL=ws://127.0.0.1:9119/api/ws
HERMES_DASH_TOKEN_FILE=/root/.hermes/.dash_token

# Home Assistant: без обеих переменных быстрый дом выключен
HASS_URL=
HASS_TOKEN=

# MQTT: сущности Гермеса в HA (notify/sensor/button) и озвучка из автоматизаций.
# Пустой MQTT_HOST выключает мост целиком.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
MQTT_PREFIX=hermes/stations

# Пороги конца реплики
VOICE_SILENCE_MS=900
VOICE_HARD_SILENCE_MS=3500
SMART_TURN_THRESHOLD=0.75

# ── Сбор данных ключевого слова ─────────────────────────────────────────
# KWS_TRAIN=0 выключает запись positives/negatives/unclear/misses.
KWS_TRAIN=1
KWS_TRAIN_DIR=/srv/kws/train

# Нижняя граница полосы промахов: пик в [KWS_MISS_MIN, порог) проверяется
# распознаванием и при наличии имени уходит в misses. Это НЕ порог реакции.
KWS_MISS_MIN=0.80

# Кольцо последнего часа на диске: 115 МБ/час на колонку, старые куски
# удаляются при ротации. Нужно, чтобы разобрать «сказал, а колонка промолчала».
KWS_RING=1
KWS_RING_DIR=/srv/kws/ring
KWS_RING_KEEP_S=3600
KWS_RING_CHUNK_S=300
